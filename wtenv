def die(message, code=1):
    print(f"wtenv: {message}", file=sys.stderr)
    sys.exit(code)


def log(message):
    print(f"==> {message}", flush=True)


def parse_env_file(path):
    values = {}
    if not path.exists():
        return values
    for raw in path.read_text().splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        key = key.strip().removeprefix("export ").strip()
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        else:
            value = re.sub(r"\s+#.*$", "", value)
        values[key] = value
    return values


def load_config():
    config = dict(DEFAULTS)
    config.update(parse_env_file(CONFIG_FILE))
    for key in DEFAULTS:
        if key in os.environ:
            config[key] = os.environ[key]
    return config


def run(cmd, check=True, capture=False, **kwargs):
    result = subprocess.run(cmd, text=True, capture_output=capture, **kwargs)
    if check and result.returncode != 0:
        detail = (result.stderr or result.stdout or "").strip() if capture else ""
        die(f"command failed ({result.returncode}): {' '.join(cmd)}\n{detail}")
    return result


def docker(*args, check=True, capture=True):
    return run(["docker", *args], check=check, capture=capture)


@contextlib.contextmanager
def file_lock(path):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    with open(path, "w") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        yield


def state_lock():
    return file_lock(LOCK_FILE)


def update_entry(slug, **fields):
    with state_lock():
        state = read_state()
        if slug in state:
            state[slug].update(fields)
            write_state(state)


def read_state():
    if not STATE_FILE.exists():
        return {}
    return json.loads(STATE_FILE.read_text())


def write_state(state):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    tmp.replace(STATE_FILE)


def worktree_root(path):
    result = run(["git", "-C", str(path), "rev-parse", "--show-toplevel"], check=False, capture=True)
    if result.returncode != 0:
        die(f"{path} is not inside a git worktree")
    root = Path(result.stdout.strip())
    if not (root / "backend/manage.py").exists() or not (root / "frontend/package.json").exists():
        die(f"{root} does not look like a moxie-link checkout")
    return root


def slug_for(root):
    return re.sub(r"[^a-z0-9]+", "-", root.name.lower()).strip("-")


def port_free(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            sock.bind(("0.0.0.0", port))
        except OSError:
            return False
    return True


def allocate(config, root):
    slug = slug_for(root)
    with state_lock():
        state = read_state()
        entry = state.get(slug)
        if entry and entry["path"] != str(root):
            die(f"slug {slug} already belongs to {entry['path']}")
        if not entry:
            used = {e["index"] for e in state.values()}
            frontend_base = int(config["WTENV_FRONTEND_PORT_BASE"])
            backend_base = int(config["WTENV_BACKEND_PORT_BASE"])
            for index in range(1, 100):
                if index in used:
                    continue
                if port_free(frontend_base + index) and port_free(backend_base + index):
                    break
            else:
                die("no free port slots left; run `wtenv prune` or `wtenv destroy` on an old env")
            entry = {
                "slug": slug,
                "path": str(root),
                "index": index,
                "frontend_port": frontend_base + index,
                "backend_port": backend_base + index,
                "db": "wt_" + slug.replace("-", "_"),
                "created_at": int(time.time()),
            }
            state[slug] = entry
            write_state(state)
        return entry


def find_entry(root):
    slug = slug_for(root)
    entry = read_state().get(slug)
    if not entry:
        die(f"no env for {root.name}; run `wtenv up` first")
    return entry


