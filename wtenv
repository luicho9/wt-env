def tailnet_host():
    result = run(["tailscale", "status", "--json"], check=False, capture=True)
    if result.returncode != 0:
        return None
    with contextlib.suppress(ValueError, KeyError):
        return json.loads(result.stdout)["Self"]["DNSName"].rstrip(".")
    return None


def ts_hostname(entry):
    return f"wt-{entry['slug']}"[:63]


def urls(config, entry):
    host = tailnet_host()
    frontend_port = entry["frontend_port"]
    link = {
        "app": f"http://localhost:{frontend_port}",
        "api": f"http://localhost:{entry['backend_port']}",
        "tailnet": None,
        "tailnet_port": f"http://{host}:{frontend_port}" if host else None,
        "tailnet_short": f"http://{host.split('.')[0]}:{frontend_port}" if host else None,
    }
    if host and config["WTENV_TS_AUTHKEY"]:
        domain = host.split(".", 1)[1]
        link["tailnet"] = f"https://{ts_hostname(entry)}.{domain}"
    else:
        link["tailnet"] = link["tailnet_port"]
    return link


def psql(config, sql, db="postgres", check=True):
    base = parse_env_file(Path(config["WTENV_MAIN_CHECKOUT"]) / "backend/.env")
    user = base.get("DATABASE_USER", "test")
    return docker(
        "exec", config["WTENV_DB_CONTAINER"], "psql", "-U", user, "-d", db, "-v", "ON_ERROR_STOP=1", "-Atc", sql,
        check=check,
    )


def db_exists(config, name):
    return psql(config, f"SELECT 1 FROM pg_database WHERE datname = '{name}'").stdout.strip() == "1"


def build_template(config):
    template = config["WTENV_TEMPLATE_DB"]
    source = config["WTENV_DB_SOURCE"]
    base = parse_env_file(Path(config["WTENV_MAIN_CHECKOUT"]) / "backend/.env")
    user = base.get("DATABASE_USER", "test")
    log(f"building template {template} from {source} (pg_dump | pg_restore, takes a minute)")
    if db_exists(config, template):
        psql(config, f"ALTER DATABASE {template} WITH is_template false")
        psql(config, f"DROP DATABASE {template} WITH (FORCE)")
    psql(config, f"CREATE DATABASE {template}")
    pipeline = (
        f"pg_dump -U {user} -Fc {source} | "
        f"pg_restore -U {user} -d {template} --no-owner --no-privileges --exit-on-error"
    )
    result = docker("exec", config["WTENV_DB_CONTAINER"], "sh", "-c", pipeline, check=False, capture=False)
    if result.returncode != 0:
        die("template restore failed")
    psql(config, f"ALTER DATABASE {template} WITH is_template true")
    TEMPLATE_STATE_FILE.unlink(missing_ok=True)
    log(f"template {template} ready")


def migrations_fingerprint(backend):
    digest = hashlib.sha256()
    for path in sorted((backend / "src").rglob("migrations/*.py")):
        digest.update(str(path.relative_to(backend)).encode())
        digest.update(path.read_bytes())
    return digest.hexdigest()[:16]


def migrate_template(config):
    template = config["WTENV_TEMPLATE_DB"]
    main_backend = Path(config["WTENV_MAIN_CHECKOUT"]) / "backend"
    fingerprint = migrations_fingerprint(main_backend)
    stored = json.loads(TEMPLATE_STATE_FILE.read_text()) if TEMPLATE_STATE_FILE.exists() else {}
    if stored.get("migrations") == fingerprint:
        return
    log(f"migrating {template} to the main checkout's migrations (once per main update)")
    env_file = STATE_DIR / "template.env"
    write_backend_env(config, env_file, db=template, redis="redis", origins=[], frontend_url="http://localhost")
    venv = venv_volume(main_backend.parent)
    ensure_volume(config, venv)
    ensure_volume(config, "wtenv-uv-cache")
    logfile = STATE_DIR / "template-migrate.log"
    with open(logfile, "w") as out:
        result = subprocess.run(
            ["docker", "run", "--rm", "--network", config["WTENV_NETWORK"], "--env-file", str(env_file),
             "-v", f"{main_backend}:/app", "-v", f"{venv}:/app/.venv", "-v", "wtenv-uv-cache:/uv-cache",
             "-w", "/app", config["WTENV_IMAGE"], "sh", "-c",
             "uv sync --frozen --group test --quiet && python manage.py migrate --noinput"],
            stdout=out, stderr=subprocess.STDOUT,
        )
    if result.returncode != 0:
        print(f"wtenv: warning: migrating the template failed (see {logfile}); worktrees will migrate themselves",
              file=sys.stderr)
        return
    TEMPLATE_STATE_FILE.write_text(json.dumps({"migrations": fingerprint, "at": int(time.time())}))


def ensure_database(config, entry, reset=False):
    template = config["WTENV_TEMPLATE_DB"]
    db = entry["db"]
    with file_lock(TEMPLATE_LOCK_FILE):
        if not db_exists(config, template):
            build_template(config)
        if reset or not db_exists(config, db):
            migrate_template(config)
        clone_database(config, entry, template, reset)


def clone_database(config, entry, template, reset):
    db = entry["db"]
    if reset and db_exists(config, db):
        log(f"dropping {db}")
        psql(config, f"DROP DATABASE {db} WITH (FORCE)")
    if not db_exists(config, db):
        log(f"creating {db} from {template}")
        psql(config, f"CREATE DATABASE {db} TEMPLATE {template}")


def container_state(name):
    result = docker("inspect", "-f", "{{.State.Status}}", name, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def labels(entry, role):
    return ["--label", f"wtenv.slug={entry['slug']}", "--label", f"wtenv.role={role}"]


def ensure_redis(config, entry):
    name = names(entry)["redis"]
    status = container_state(name)
    if status == "running":
        return
    if status:
        docker("rm", "-f", name)
    log(f"starting {name}")
    docker(
        "run", "-d", "--name", name, "--network", config["WTENV_NETWORK"], "--restart", "unless-stopped",
        *labels(entry, "redis"), "redis:7-alpine", "redis-server", "--save", "", "--appendonly", "no",
    )


def ensure_volume(config, name):
    if docker("volume", "inspect", name, check=False).returncode == 0:
        return
    docker("volume", "create", "--label", "wtenv=1", name)
    docker("run", "--rm", "-u", "0", "-v", f"{name}:/target", "--entrypoint", "chown", config["WTENV_IMAGE"],
           "1000:1000", "/target")


def venv_volume(root):
    digest = hashlib.sha256((root / "backend/uv.lock").read_bytes()).hexdigest()[:12]
    return f"wtenv-venv-{digest}"


def backend_env(config, entry):
    frontend_port = entry["frontend_port"]
    link = urls(config, entry)
    origins = [f"http://localhost:{frontend_port}", f"http://127.0.0.1:{frontend_port}"]
    origins += [url for key in ("tailnet", "tailnet_port", "tailnet_short") if (url := link[key])]
    path = env_dir(entry) / "backend.env"
    write_backend_env(config, path, db=entry["db"], redis=names(entry)["redis"],
                      origins=list(dict.fromkeys(origins)), frontend_url=link["tailnet"] or link["app"])
    return path


def write_backend_env(config, path, db, redis, origins, frontend_url):
    base = parse_env_file(Path(config["WTENV_MAIN_CHECKOUT"]) / "backend/.env")
    base.setdefault("PCC_TENANT_KEY", "moxie")
    base.update(parse_env_file(BACKEND_OVERRIDES_FILE))
    base.update({
        "DEBUG": "True",
        "DATABASE_NAME": db,
        "DATABASE_HOST": "database",
        "DATABASE_PORT": "5432",
        "REDIS_HOST": redis,
        "REDIS_PORT": "6379",
        "REDIS_URL": f"redis://{redis}:6379/0",
        "CELERY_BROKER_URL": f"redis://{redis}:6379/0",
        "CELERY_RESULT_BACKEND": f"redis://{redis}:6379/0",
        "ALLOWED_HOSTS": "*",
        "CORS_ALLOWED_ORIGINS": ",".join(origins),
        "CSRF_TRUSTED_ORIGINS": ",".join(origins),
        "FRONTEND_URL": frontend_url,
        "UV_LINK_MODE": "copy",
        "UV_CACHE_DIR": "/uv-cache",
        "UV_PROJECT_ENVIRONMENT": "/app/.venv",
    })
    path.write_text("".join(f"{k}={v}\n" for k, v in base.items() if "\n" not in v))
    path.chmod(0o600)


def backend_run_args(config, entry, root, role):
    venv = venv_volume(root)
    ensure_volume(config, venv)
    ensure_volume(config, "wtenv-uv-cache")
    return [
        "--network", config["WTENV_NETWORK"],
        "--env-file", str(backend_env(config, entry)),
        "-v", f"{root / 'backend'}:/app",
        "-v", f"{venv}:/app/.venv",
        "-v", "wtenv-uv-cache:/uv-cache",
        "-w", "/app",
        *labels(entry, role),
    ]


BACKEND_SCRIPT = (
    "uv sync --frozen --group test --quiet"
    " && if [ \"$WTENV_MIGRATE\" = 1 ]; then python manage.py migrate --noinput; fi"
    " && exec python manage.py runserver 0.0.0.0:9000 --skip-checks"
)


def container_label(name, label):
    result = docker("inspect", "-f", f'{{{{index .Config.Labels "{label}"}}}}', name, check=False)
    return result.stdout.strip() if result.returncode == 0 else None


def start_backend(config, entry, root, recreate=False, migrate=True):
    name = names(entry)["app"]
    venv = venv_volume(root)
    status = container_state(name)
    if status == "running" and container_label(name, "wtenv.venv") != venv:
        recreate = True
    if status == "running" and not recreate:
        if migrate:
            log("new migrations: running migrate in the backend container")
            result = run(["docker", "exec", name, "python", "manage.py", "migrate", "--noinput"], check=False)
            if result.returncode != 0:
                die("migrate failed; fix the branch and rerun `wtenv up`")
        return
    if status:
        docker("rm", "-f", name)
    log(f"starting {name} on :{entry['backend_port']}" + (" (uv sync + migrate first)" if migrate else ""))
    args = backend_run_args(config, entry, root, "app")
    docker(
        "run", "-d", "--name", name, "-p", f"{entry['backend_port']}:9000", *args,
        "--label", f"wtenv.venv={venv}", "-e", f"WTENV_MIGRATE={1 if migrate else 0}",
        config["WTENV_IMAGE"], "sh", "-c", BACKEND_SCRIPT,
    )


def wait_backend(entry, seconds=300):
    name = names(entry)["app"]
    url = f"http://127.0.0.1:{entry['backend_port']}/health/"
    deadline = time.time() + seconds
    while time.time() < deadline:
        if http_ok(url):
            return
        if container_state(name) != "running":
            tail_container(name, 80)
            die("backend exited during startup (uv sync / migrate / boot failed, logs above); "
                "fix the branch and rerun `wtenv up`")
        time.sleep(1)
    tail_container(name, 80)
    die(f"backend did not become healthy at {url} within {seconds}s")


def start_celery(config, entry, root, recreate=False):
    name = names(entry)["celery"]
    status = container_state(name)
    if status == "running" and not recreate:
        return
    if status:
        docker("rm", "-f", name)
    log(f"starting {name}")
    args = backend_run_args(config, entry, root, "celery")
    docker(
        "run", "-d", "--name", name, *args, config["WTENV_IMAGE"],
        "celery", "-A", "src", "worker", "--loglevel=info", "--concurrency=2",
        "-Q", CELERY_QUEUES, "--hostname", f"wt-{entry['slug']}@%h",
    )


def ensure_tailscale(config, entry):
    if not config["WTENV_TS_AUTHKEY"]:
        return
    name = names(entry)["ts"]
    status = container_state(name)
    if status == "running":
        return
    if status:
        docker("rm", "-f", name)
    serve = {
        "TCP": {"443": {"HTTPS": True}},
        "Web": {
            "${TS_CERT_DOMAIN}:443": {
                "Handlers": {"/": {"Proxy": f"http://host.docker.internal:{entry['frontend_port']}"}},
            },
        },
    }
    directory = env_dir(entry)
    (directory / "serve.json").write_text(json.dumps(serve, indent=2))
    secrets = directory / "ts.env"
    secrets.write_text(f"TS_AUTHKEY={config['WTENV_TS_AUTHKEY']}\n")
    secrets.chmod(0o600)
    log(f"starting {name} as {ts_hostname(entry)}")
    docker(
        "run", "-d", "--name", name, "--restart", "unless-stopped",
        "--add-host", "host.docker.internal:host-gateway",
        "--env-file", str(secrets),
        "-e", f"TS_HOSTNAME={ts_hostname(entry)}",
        "-e", "TS_USERSPACE=true",
        "-e", "TS_STATE_DIR=/var/lib/tailscale",
        "-e", "TS_SERVE_CONFIG=/config/serve.json",
        "-v", f"{directory / 'serve.json'}:/config/serve.json:ro",
        "-v", f"{ts_state_volume(entry)}:/var/lib/tailscale",
        *labels(entry, "ts"), config["WTENV_TS_IMAGE"],
    )


def ts_state_volume(entry):
    return f"wt-{entry['slug']}-ts-state"


def stop_tailscale(entry, forget=False):
    docker("rm", "-f", names(entry)["ts"], check=False)
    if forget:
        docker("volume", "rm", ts_state_volume(entry), check=False)


def ensure_git_exclude(root):
    common = run(["git", "-C", str(root), "rev-parse", "--path-format=absolute", "--git-common-dir"],
                 capture=True).stdout.strip()
    exclude = Path(common) / "info/exclude"
    exclude.parent.mkdir(parents=True, exist_ok=True)
    current = exclude.read_text() if exclude.exists() else ""
    if ".wtenv/" not in current.split():
        exclude.write_text(current.rstrip("\n") + ("\n" if current else "") + ".wtenv/\n")


def node_modules_stale(frontend):
    marker = frontend / "node_modules/.modules.yaml"
    lock = frontend / "pnpm-lock.yaml"
    return not marker.exists() or lock.stat().st_mtime > marker.stat().st_mtime


def frontend_env(config, entry):
    base = parse_env_file(Path(config["WTENV_MAIN_CHECKOUT"]) / "frontend/.env")
    env = dict(os.environ)
    env.update({k: v for k, v in base.items() if k.startswith("VITE_")})
    env.update({
        "VITE_BASE_API_URL": "",
        "VITE_WEB_SOCKET_URL": f"ws://localhost:{entry['backend_port']}/ws",
        "WTENV_BACKEND_URL": f"http://127.0.0.1:{entry['backend_port']}",
        "WTENV_FRONTEND_PORT": str(entry["frontend_port"]),
        "BROWSER": "none",
    })
    return env


def vite_pid(entry):
    pidfile = env_dir(entry) / "vite.pid"
    if not pidfile.exists():
        return None
    pid = int(pidfile.read_text().strip())
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        pidfile.unlink(missing_ok=True)
        return None
    return pid


def start_frontend(config, entry, root):
    frontend = root / "frontend"
    if node_modules_stale(frontend):
        log("pnpm install --frozen-lockfile")
        logfile = env_dir(entry) / "pnpm.log"
        with open(logfile, "w") as out:
            result = subprocess.run(["pnpm", "install", "--frozen-lockfile"], cwd=frontend,
                                    stdout=out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
        if result.returncode != 0:
            tail_file(logfile)
            die("pnpm install failed")
    if vite_pid(entry):
        return
    ensure_git_exclude(root)
    wrapper = frontend / ".wtenv/vite.config.mts"
    wrapper.parent.mkdir(exist_ok=True)
    wrapper.write_text(VITE_WRAPPER)
    shutil.copyfile(CLIP_OVERLAY, wrapper.parent / "clip-overlay.js")
    logfile = env_dir(entry) / "vite.log"
    log(f"starting vite on :{entry['frontend_port']}")
    with open(logfile, "w") as out:
        proc = subprocess.Popen(
            [str(frontend / "node_modules/.bin/vite"), "--config", str(wrapper)],
            cwd=frontend, env=frontend_env(config, entry), stdout=out, stderr=subprocess.STDOUT,
            stdin=subprocess.DEVNULL, start_new_session=True,
        )
    (env_dir(entry) / "vite.pid").write_text(str(proc.pid))


def stop_frontend(entry):
    pid = vite_pid(entry)
    if not pid:
        return
    with contextlib.suppress(ProcessLookupError):
        os.killpg(pid, signal.SIGTERM)
    for _ in range(20):
        if not vite_pid(entry):
            break
        time.sleep(0.25)
    else:
        with contextlib.suppress(ProcessLookupError):
            os.killpg(pid, signal.SIGKILL)
    (env_dir(entry) / "vite.pid").unlink(missing_ok=True)


def http_ok(url, timeout=3):
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:
            return response.status < 500
    except urllib.error.HTTPError as error:
        return error.code < 500
    except (urllib.error.URLError, OSError):
        return False


def wait_for(label, url, seconds, on_fail):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if http_ok(url):
            return
        time.sleep(1)
    on_fail()
    die(f"{label} did not become healthy at {url} within {seconds}s")


def tail_container(name, lines=60):
    result = docker("logs", "--tail", str(lines), name, check=False)
    print(result.stdout + result.stderr, file=sys.stderr)


def tail_file(path, lines=60):
    if path.exists():
        print("\n".join(path.read_text().splitlines()[-lines:]), file=sys.stderr)


def status_of(entry):
    n = names(entry)
    return {
        "backend": container_state(n["app"]) or "absent",
        "redis": container_state(n["redis"]) or "absent",
        "celery": container_state(n["celery"]) or "off",
        "frontend": "running" if vite_pid(entry) else "stopped",
        "tailscale": container_state(n["ts"]) or "off",
    }


def print_info(config, entry, as_json=False):
    link = urls(config, entry)
    info = {
        "slug": entry["slug"],
        "path": entry["path"],
        "app_url": link["app"],
        "api_url": link["api"],
        "tailnet_url": link["tailnet"],
        "database": entry["db"],
        "login_email": config["WTENV_LOGIN_EMAIL"] or None,
        "login_password": config["WTENV_LOGIN_PASSWORD"] or None,
        "status": status_of(entry),
        "logs": {
            "backend": f"docker logs {names(entry)['app']}",
            "frontend": str(env_dir(entry) / "vite.log"),
        },
    }
    if as_json:
        print(json.dumps(info, indent=2))
        return
    status = info["status"]
    print(f"\nwtenv {entry['slug']}")
    print(f"  app       {link['app']}")
    if link["tailnet"]:
        print(f"  tailnet   {link['tailnet']}")
    print(f"  api       {link['api']}")
    print(f"  database  {entry['db']}")
    if info["login_email"]:
        print(f"  login     {info['login_email']} / {info['login_password']}")
    print("  status    " + ", ".join(f"{k}={v}" for k, v in status.items()))


def dirty_files(root, pathspec):
    result = run(["git", "-C", str(root), "status", "--porcelain", "--", pathspec], capture=True)
    return {line[3:] for line in result.stdout.splitlines() if line.startswith(" M")}


def run_in_thread(target, *args):
    failure = {}

    def wrapped():
        try:
            target(*args)
        except SystemExit as error:
            failure["code"] = error.code or 1
        except Exception as error:
            print(f"wtenv: {error}", file=sys.stderr)
            failure["code"] = 1

    thread = threading.Thread(target=wrapped)
    thread.start()
    return thread, failure


def bring_up_frontend(config, entry, root):
    start_frontend(config, entry, root)
    wait_for("frontend", f"http://127.0.0.1:{entry['frontend_port']}/", 120,
             lambda: tail_file(env_dir(entry) / "vite.log"))


def cmd_up(args, config):
    root = worktree_root(args.path)
    entry = allocate(config, root)
    ensure_tailscale(config, entry)
    if args.restart:
        stop_frontend(entry)
    vite_was_running = bool(vite_pid(entry))
    inlang = "frontend/project.inlang"
    dirty_before = dirty_files(root, inlang)
    frontend, frontend_failure = run_in_thread(bring_up_frontend, config, entry, root)

    ensure_database(config, entry, reset=args.reset_db)
    if args.reset_db:
        entry["migrated"] = None
    ensure_redis(config, entry)
    fingerprint = migrations_fingerprint(root / "backend")
    migrate = not args.skip_migrate and entry.get("migrated") != fingerprint
    start_backend(config, entry, root, recreate=args.restart or args.reset_db, migrate=migrate)
    if args.celery:
        start_celery(config, entry, root, recreate=args.restart)
    wait_backend(entry)
    if migrate:
        update_entry(entry["slug"], migrated=fingerprint)

    frontend.join()
    if frontend_failure:
        sys.exit(frontend_failure["code"])
    if not vite_was_running:
        time.sleep(1)
        touched = sorted(dirty_files(root, inlang) - dirty_before)
        if touched:
            run(["git", "-C", str(root), "checkout", "--", *touched], capture=True)
    print_info(config, entry, args.json)
    link = urls(config, entry)
    if config["WTENV_TS_AUTHKEY"] and not http_ok(link["tailnet"], timeout=2):
        print(f"\n  note: {link['tailnet']} is still provisioning its HTTPS cert; it's usually ready within a minute",
              file=sys.stderr)


def stop_env(entry, forget=False):
    stop_frontend(entry)
    stop_tailscale(entry, forget=forget)
    for name in names(entry).values():
        docker("rm", "-f", name, check=False)


def cmd_down(args, config):
    entry = find_entry(worktree_root(args.path))
    stop_env(entry)
    log(f"stopped {entry['slug']} (database {entry['db']} kept)")


def destroy_entry(config, entry, forget=False):
    stop_env(entry, forget=forget)
    if db_exists(config, entry["db"]):
        psql(config, f"DROP DATABASE {entry['db']} WITH (FORCE)")
    with state_lock():
        state = read_state()
        state.pop(entry["slug"], None)
        write_state(state)
    log(f"destroyed {entry['slug']}")


def cmd_destroy(args, config):
    destroy_entry(config, find_entry(worktree_root(args.path)))


def cmd_info(args, config):
    print_info(config, find_entry(worktree_root(args.path)), args.json)


def env_state(status):
    if status["backend"] == "running" and status["frontend"] == "running":
        return "up"
    containers = (status["backend"], status["redis"], status["celery"], status["tailscale"])
    return "stale" if any(state not in ("absent", "off") for state in containers) else "down"


def cmd_ls(args, config):
    state = read_state()
    rows = []
    for entry in sorted(state.values(), key=lambda e: e["index"]):
        status = status_of(entry)
        rows.append({**entry, "status": status, "urls": urls(config, entry)})
    if args.json:
        print(json.dumps(rows, indent=2))
        return
    if not rows:
        print("no envs")
        return
    for row in rows:
        s = row["status"]
        alive = env_state(s)
        exists = "" if Path(row["path"]).exists() else "  (worktree gone)"
        print(f"{row['slug']:<32} {alive:<5} {row['urls']['tailnet'] or row['urls']['app']}{exists}")


def cmd_logs(args, config):
    entry = find_entry(worktree_root(args.path))
    if args.service == "frontend":
        cmd = ["tail", "-n", str(args.lines)] + (["-f"] if args.follow else []) + [str(env_dir(entry) / "vite.log")]
    else:
        name = names(entry)["app" if args.service == "backend" else args.service]
        cmd = ["docker", "logs", "--tail", str(args.lines)] + (["-f"] if args.follow else []) + [name]
    os.execvp(cmd[0], cmd)


def cmd_exec(args, config):
    entry = find_entry(worktree_root(args.path))
    if not args.command:
        die("usage: wtenv exec -- <command>")
    cmd = args.command[1:] if args.command[0] == "--" else args.command
    os.execvp("docker", ["docker", "exec", "-i", names(entry)["app"], *cmd])


def cmd_template(args, config):
    with file_lock(TEMPLATE_LOCK_FILE):
        if not args.migrate_only:
            build_template(config)
        migrate_template(config)


def cmd_prune(args, config):
    state = read_state()
    for entry in list(state.values()):
        if not Path(entry["path"]).exists():
            destroy_entry(config, entry, forget=True)
        elif env_state(status_of(entry)) == "stale":
            stop_env(entry)
            log(f"stopped stale {entry['slug']} (database {entry['db']} kept)")
    result = docker("ps", "-a", "--filter", "label=wtenv.slug", "--format", "{{.Names}}\t{{.Label \"wtenv.slug\"}}",
                    check=False)
    for line in result.stdout.splitlines():
        name, _, slug = line.partition("\t")
        if slug not in state:
            docker("rm", "-f", name, check=False)
            log(f"removed orphan container {name}")


CLIP_INPUT_KINDS = {"move", "pointer", "key", "typing", "scroll", "load"}
CLIP_PRE = 0.25
CLIP_POST = 1.0
CLIP_SETTLE = 4.0
CLIP_MIN_GAP = 0.5
CLIP_HOLD = 1.5


def parse_timestamp(value):
    if re.fullmatch(r"\d+(\.\d+)?", value):
        number = float(value)
        return number / 1000 if number > 1e11 else number
    from datetime import datetime
    return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()


def video_duration(path):
    out = run(["ffprobe", "-v", "error", "-show_entries", "format=duration", "-of", "csv=p=0", str(path)],
              capture=True)
    return float(out.stdout.strip())


def clip_windows(events, started_at, duration, pre, post, settle, hold=0.0):
    times = sorted((e["t"] / 1000 - started_at, e["kind"]) for e in events)
    windows = []
    last_input = None
    for t, kind in times:
        if kind in CLIP_INPUT_KINDS:
            last_input = t
            windows.append([t - pre, t + post])
        elif kind == "change" and last_input is not None and t - last_input <= settle and windows:
            windows[-1][1] = max(windows[-1][1], t + post)
    if windows:
        windows[-1][1] = max(w[1] for w in windows) + hold
    clamped = sorted([max(0.0, a), min(duration, b)] for a, b in windows if b > 0 and a < duration)
    merged = []
    for a, b in clamped:
        if merged and a - merged[-1][1] <= CLIP_MIN_GAP:
            merged[-1][1] = max(merged[-1][1], b)
        else:
            merged.append([a, b])
    return [(a, b) for a, b in merged if b - a > 0.05]


def cut_video(source, segments, output, speed):
    branches = "".join(
        f"[src{i}]trim=start={a:.3f}:end={b:.3f},setpts=(PTS-STARTPTS)/{speed}[v{i}];" for i, (a, b) in enumerate(segments)
    )
    joined = "".join(f"[v{i}]" for i in range(len(segments)))
    inputs = "".join(f"[src{i}]" for i in range(len(segments)))
    graph = f"[0:v]fps=30,split={len(segments)}{inputs};{branches}{joined}concat=n={len(segments)}:v=1:a=0[out]"
    run(["ffmpeg", "-y", "-hide_banner", "-loglevel", "error", "-i", str(source), "-filter_complex", graph,
         "-map", "[out]", "-c:v", "libx264", "-preset", "veryfast", "-crf", "23", "-pix_fmt", "yuv420p",
         "-movflags", "+faststart", str(output)], capture=True)


def cmd_clip_cut(args, config):
    source = args.video.resolve()
    output = (args.output or source.with_name(f"{source.stem}-cut.mp4")).resolve()
    if not source.is_file():
        die(f"recording does not exist: {source}")
    if source == output or (output.exists() and os.path.samefile(source, output)):
        die("output must differ from the source recording")
    result = {"source": str(source), "output": str(output)}
    try:
        for name in ("pre", "post", "settle", "hold"):
            value = getattr(args, name)
            if not math.isfinite(value) or value < 0:
                raise ValueError(f"--{name} must be a finite nonnegative number")
        if not math.isfinite(args.speed) or args.speed <= 0:
            raise ValueError("--speed must be a finite positive number")
        events_text = sys.stdin.read() if str(args.events) == "-" else args.events.read_text()
        events = json.loads(events_text)
        if isinstance(events, dict):
            events = events.get("events", events.get("value", []))
        if not isinstance(events, list) or any(
            not isinstance(e, dict) or not isinstance(e.get("kind"), str)
            or not isinstance(e.get("t"), (int, float)) or not math.isfinite(e["t"])
            for e in events
        ):
            raise ValueError("events must be an array of objects with finite t and string kind")
        started_at = parse_timestamp(args.started_at)
        if not math.isfinite(started_at):
            raise ValueError("recording start must be finite")
        duration = video_duration(source)
        result["source_duration"] = round(duration, 2)
        segments = clip_windows(events, started_at, duration, args.pre, args.post, args.settle, args.hold)
        if not segments:
            raise ValueError("no input events fall inside the recording")
        cut_video(source, segments, output, args.speed)
        result.update(cut=True, duration=round(sum(b - a for a, b in segments) / args.speed, 2), speed=args.speed,
                      segments=[[round(a, 2), round(b, 2)] for a, b in segments])
    except (ValueError, TypeError, KeyError, OSError, subprocess.CalledProcessError, SystemExit) as error:
        shutil.copyfile(source, output)
        result.update(cut=False, error=str(error) or "ffmpeg failed")
        if "source_duration" in result:
            result["duration"] = result["source_duration"]
    print(json.dumps(result, indent=2))


def main():
    parser = argparse.ArgumentParser(prog="wtenv", description="Per-worktree moxie-link dev environments")
    parser.add_argument("-C", "--path", type=Path, default=Path.cwd(), help="worktree path (default: cwd)")
    sub = parser.add_subparsers(dest="cmd", required=True)

    up = sub.add_parser("up", help="start (or reuse) this worktree's env")
    up.add_argument("--celery", action="store_true", help="also run one Celery worker for all queues")
    up.add_argument("--restart", action="store_true", help="recreate backend/celery/vite processes")
    up.add_argument("--reset-db", action="store_true", help="recreate the database from the template")
    up.add_argument("--skip-migrate", action="store_true", help="skip uv sync + migrate")
    up.add_argument("--json", action="store_true")
    up.set_defaults(func=cmd_up)

    sub.add_parser("down", help="stop processes, keep the database").set_defaults(func=cmd_down)
    sub.add_parser("destroy", help="stop and drop the database, free the ports").set_defaults(func=cmd_destroy)

    info = sub.add_parser("info", help="URLs, login, status")
    info.add_argument("--json", action="store_true")
    info.set_defaults(func=cmd_info)

    ls = sub.add_parser("ls", help="list all envs")
    ls.add_argument("--json", action="store_true")
    ls.set_defaults(func=cmd_ls)

    logs = sub.add_parser("logs", help="show logs")
    logs.add_argument("service", nargs="?", default="backend", choices=["backend", "frontend", "celery", "redis", "ts"])
    logs.add_argument("-f", "--follow", action="store_true")
    logs.add_argument("-n", "--lines", type=int, default=100)
    logs.set_defaults(func=cmd_logs)

    exe = sub.add_parser("exec", help="run a command in the backend container")
    exe.add_argument("command", nargs=argparse.REMAINDER)
    exe.set_defaults(func=cmd_exec)

    template = sub.add_parser("template", help="rebuild the template DB from the main dev DB, then migrate it")
    template.add_argument("--migrate-only", action="store_true", help="only migrate it to the main checkout")
    template.set_defaults(func=cmd_template)
    sub.add_parser("prune", help="destroy envs whose worktree is gone, stop stale envs, remove orphan containers").set_defaults(func=cmd_prune)

    clip = sub.add_parser("clip", help="post-process verification recordings")
    clip_sub = clip.add_subparsers(dest="clip_cmd", required=True)
    cut = clip_sub.add_parser("cut", help="cut a recording down to the moments around logged actions")
    cut.add_argument("video", type=Path)
    cut.add_argument("--events", type=Path, required=True, help="JSON from __wtenvClip.stop() ('-' for stdin)")
    cut.add_argument("--started-at", required=True, help="recording start (ISO time or epoch ms)")
    cut.add_argument("-o", "--output", type=Path)
    cut.add_argument("--pre", type=float, default=CLIP_PRE, help="seconds kept before each action")
    cut.add_argument("--post", type=float, default=CLIP_POST, help="seconds kept after each action or its last change")
    cut.add_argument("--settle", type=float, default=CLIP_SETTLE,
                     help="seconds after an action during which page changes extend its window")
    cut.add_argument("--hold", type=float, default=CLIP_HOLD, help="extra seconds kept on the final state")
    cut.add_argument("--speed", type=float, default=0.75, help="playback speed (default: 0.75; 1 for real time)")
    cut.set_defaults(func=cmd_clip_cut)

    args = parser.parse_args()
    args.func(args, load_config())


if __name__ == "__main__":
    main()
